# Baked into the bundle at build time by Vite. Not a secret -- the API is
# public and guarded by a Cognito ID token, which no build ever sees.
VITE_API_BASE=https://0xz7v8yx0i.execute-api.us-east-1.amazonaws.com

# Neither is a secret. The client id is in every sign-in request the browser
# makes and Google documents it as public; the domain is a public URL. The
# passcode never entered this file and neither does anything else.
VITE_COGNITO_DOMAIN=https://schedule-ai-app.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=6e88nr9757csi4ai3kv42r4bt4
